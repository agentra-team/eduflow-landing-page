# Bắt buộc ở production (OQ-L01): URL http(s) đầy đủ như https://tên-miền, không trỏ về localhost; build production dừng nếu trống hoặc sai. Để trống khi chạy máy dev → http://localhost:3000
# Bị từ chối ở production: trống, thiếu http:// hay https://, localhost, 127.0.0.1, [::1], 0.0.0.0, *.localhost. Khoảng trắng hai đầu và dấu / cuối được tự bỏ.
NEXT_PUBLIC_SITE_URL=
# Feed kênh ổn định mà electron-updater của app đọc (OQ-L02). Để trống → trạng thái sắp phát hành nếu snapshot rỗng.
DOWNLOAD_FEED_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_CONSENT_BANNER=on
